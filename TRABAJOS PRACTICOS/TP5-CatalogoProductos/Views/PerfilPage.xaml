<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatalogoProductos.Views.PerfilPage"
             Title="Perfil">

    <ScrollView>
        <StackLayout x:Name="contenidoPerfil" Spacing="0" Opacity="0">
            <!-- Header con foto de perfil -->
            <Grid BackgroundColor="{StaticResource Primario}"
                  Padding="20"
                  HeightRequest="{OnIdiom Phone=200, Tablet=250, Desktop=300}">
                <StackLayout VerticalOptions="Center" Spacing="10">
                    <Frame WidthRequest="100"
                           HeightRequest="100"
                           CornerRadius="50"
                           Padding="0"
                           HorizontalOptions="Center"
                            BorderColor="White">
                        <Image Source="perfil.png" Aspect="AspectFill" />
                    </Frame>
                    <Label Text="Juan Pérez"
                           FontSize="{OnIdiom Phone=24, Tablet=28, Desktop=32}"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" />
                    <Label Text="juan@email.com"
                           FontSize="{OnIdiom Phone=16, Tablet=18, Desktop=20}"
                           TextColor="White"
                           HorizontalOptions="Center" />
                </StackLayout>
            </Grid>

            <!-- Estadísticas -->
            <Grid Padding="{OnIdiom Phone=20, Tablet=30, Desktop=40}" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackLayout Grid.Column="0" Spacing="5">
                    <Label Text="25"
                           FontSize="24"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <Label Text="Compras"
                           Style="{StaticResource Caption}"
                           HorizontalOptions="Center" />
                </StackLayout>
                <StackLayout Grid.Column="1" Spacing="5">
                    <Label Text="5"
                           FontSize="24"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <Label Text="Favoritos"
                           Style="{StaticResource Caption}"
                           HorizontalOptions="Center" />
                </StackLayout>
                <StackLayout Grid.Column="2" Spacing="5">
                    <Label Text="12"
                           FontSize="24"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <Label Text="Reseñas"
                           Style="{StaticResource Caption}"
                           HorizontalOptions="Center" />
                </StackLayout>
            </Grid>

            <!-- Opciones -->
            <StackLayout Padding="{OnIdiom Phone=20, Tablet=30, Desktop=40}" Spacing="10">
                <Frame Style="{StaticResource Card}" Padding="0">
                    <StackLayout Spacing="0">
                        <Grid Padding="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Text="👤" FontSize="24" VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Editar Perfil"
                                   Style="{StaticResource Body}"
                                   VerticalOptions="Center"
                                   Margin="15,0,0,0" />
                            <Label Grid.Column="2"
                                   Text="›"
                                   FontSize="24"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEditarPerfilTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light=LightGray, Dark=Gray}"
                                 Margin="15,0" />
                        <Grid Padding="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Text="📦" FontSize="24" VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Mis Pedidos"
                                   Style="{StaticResource Body}"
                                   VerticalOptions="Center"
                                   Margin="15,0,0,0" />
                            <Label Grid.Column="2"
                                   Text="›"
                                   FontSize="24"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMisPedidosTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light=LightGray, Dark=Gray}"
                                 Margin="15,0" />
                        <Grid Padding="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Text="❤" FontSize="24" VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Mis Favoritos"
                                   Style="{StaticResource Body}"
                                   VerticalOptions="Center"
                                   Margin="15,0,0,0" />
                            <Label Grid.Column="2"
                                   Text="›"
                                   FontSize="24"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFavoritosTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light=LightGray, Dark=Gray}"
                                 Margin="15,0" />
                        <Grid Padding="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Text="🛒" FontSize="24" VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Mi Carrito"
                                   Style="{StaticResource Body}"
                                   VerticalOptions="Center"
                                   Margin="15,0,0,0" />
                            <Label Grid.Column="2"
                                   Text="›"
                                   FontSize="24"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCarritoTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light=LightGray, Dark=Gray}"
                                 Margin="15,0" />
                        <Grid Padding="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Text="⚙" FontSize="24" VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Configuración"
                                   Style="{StaticResource Body}"
                                   VerticalOptions="Center"
                                   Margin="15,0,0,0" />
                            <Label Grid.Column="2"
                                   Text="›"
                                   FontSize="24"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnConfiguracionTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </StackLayout>
                </Frame>

                <Button Text="Cerrar Sesión"
                        Style="{StaticResource BtnSecundario}"
                        TextColor="{StaticResource Error}"
                        BorderColor="{StaticResource Error}"
                        Clicked="OnCerrarSesionClicked"
                        Margin="0,20,0,0" />
            </StackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>
