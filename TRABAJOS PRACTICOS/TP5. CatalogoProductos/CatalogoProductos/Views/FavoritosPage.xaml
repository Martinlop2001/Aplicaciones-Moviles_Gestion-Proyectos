<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatalogoProductos.Views.FavoritosPage"
             Title="Favoritos">

    <CollectionView x:Name="collectionViewFavoritos"
                    Margin="15"
                    SelectionMode="Single"
                    SelectionChanged="OnProductoSelected">
        <CollectionView.ItemsLayout>
            <GridItemsLayout Orientation="Vertical"
                             Span="{OnIdiom Phone=2, Tablet=3, Desktop=4}"
                             VerticalItemSpacing="15"
                             HorizontalItemSpacing="15" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Style="{StaticResource Card}" Padding="10">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="150" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Image Source="{Binding Imagen}"
                               Aspect="AspectFill"
                               Grid.Row="0" />
                        <Label Text="{Binding Nombre}"
                               Grid.Row="1"
                               Style="{StaticResource Body}"
                               FontAttributes="Bold"
                               LineBreakMode="TailTruncation"
                               MaxLines="2" />
                        <Label Text="{Binding Precio, StringFormat='${0:F2}'}"
                               Grid.Row="2"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Exito}" />
                        <StackLayout Grid.Row="3"
                                     Orientation="Horizontal"
                                     Spacing="5">
                            <Label Text="⭐" FontSize="14" />
                            <Label Text="{Binding Calificacion}"
                                   Style="{StaticResource Caption}" />
                        </StackLayout>
                    </Grid>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
        <CollectionView.EmptyView>
            <StackLayout VerticalOptions="Center" Padding="50">
                <Label Text="❤" FontSize="64" HorizontalOptions="Center" />
                <Label Text="No tienes favoritos"
                       Style="{StaticResource H2}" HorizontalOptions="Center" />
                <Label Text="Agrega productos a favoritos desde el detalle"
                       Style="{StaticResource Caption}" HorizontalOptions="Center" />
            </StackLayout>
        </CollectionView.EmptyView>
    </CollectionView>
</ContentPage>
