<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatalogoProductos.Views.ProductosPage"
             Title="Productos">
    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de búsqueda -->
        <Frame Grid.Row="0"
               Style="{StaticResource FrameBusqueda}"
               Margin="15,10">
            <SearchBar x:Name="searchBar"
                       Placeholder="Buscar productos..."
                       Style="{StaticResource SearchBarEstilo}"
                       TextChanged="OnSearchTextChanged" />
        </Frame>

        <!-- Filtros avanzados -->
        <Frame Grid.Row="1"
               Style="{StaticResource CardBlanco}"
               Padding="10"
               Margin="15,0"
               IsVisible="{OnIdiom Phone=False, Tablet=True, Desktop=True}">
            <Grid ColumnSpacing="10" RowSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Text="Precio min:" Style="{StaticResource Caption}" VerticalOptions="Center" />
                <Entry x:Name="entryPrecioMin" Grid.Row="0" Grid.Column="1" Placeholder="$0" Keyboard="Numeric" Style="{StaticResource Input}" HeightRequest="40" />

                <Label Grid.Row="0" Grid.Column="2" Text="Precio max:" Style="{StaticResource Caption}" VerticalOptions="Center" />
                <Entry x:Name="entryPrecioMax" Grid.Row="0" Grid.Column="3" Placeholder="$9999" Keyboard="Numeric" Style="{StaticResource Input}" HeightRequest="40" />

                <Label Grid.Row="0" Grid.Column="4" Text="Calif. min:" Style="{StaticResource Caption}" VerticalOptions="Center" />
                <Entry x:Name="entryCalifMin" Grid.Row="0" Grid.Column="5" Placeholder="0" Keyboard="Numeric" Style="{StaticResource Input}" HeightRequest="40" />

                <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                        Text="Filtrar" Style="{StaticResource BtnPrimario}" HeightRequest="40"
                        Clicked="OnFiltrarClicked" Margin="5" />
                <Button Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                        Text="Limpiar" Style="{StaticResource BtnSecundario}" HeightRequest="40"
                        Clicked="OnLimpiarFiltrosClicked" Margin="5" />
                <Button Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2"
                        Text="Ver Favoritos ❤" Style="{StaticResource BtnSecundario}" HeightRequest="40"
                        Clicked="OnVerFavoritosClicked" Margin="5" />
            </Grid>
        </Frame>

        <!-- Botón flotante de filtros para teléfono -->
        <Button Grid.Row="1"
                x:Name="btnFiltrosMovil"
                Text="Filtros ⚙"
                Style="{StaticResource BtnSecundario}"
                HeightRequest="40"
                Margin="15,0"
                IsVisible="{OnIdiom Phone=True, Tablet=False, Desktop=False}"
                Clicked="OnToggleFiltrosMovilClicked" />

        <StackLayout Grid.Row="1" x:Name="panelFiltrosMovil" IsVisible="False" Margin="15,5" Padding="10">
            <Label Text="Precio mínimo:" Style="{StaticResource Caption}" />
            <Entry x:Name="entryPrecioMinMovil" Placeholder="$0" Keyboard="Numeric" Style="{StaticResource Input}" HeightRequest="40" />
            <Label Text="Precio máximo:" Style="{StaticResource Caption}" />
            <Entry x:Name="entryPrecioMaxMovil" Placeholder="$9999" Keyboard="Numeric" Style="{StaticResource Input}" HeightRequest="40" />
            <Label Text="Calificación mínima:" Style="{StaticResource Caption}" />
            <Entry x:Name="entryCalifMinMovil" Placeholder="0" Keyboard="Numeric" Style="{StaticResource Input}" HeightRequest="40" />
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Text="Filtrar" Style="{StaticResource BtnPrimario}" HeightRequest="40" Clicked="OnFiltrarClicked" />
                <Button Grid.Column="1" Text="Limpiar" Style="{StaticResource BtnSecundario}" HeightRequest="40" Clicked="OnLimpiarFiltrosClicked" />
            </Grid>
            <Button Text="Ver Favoritos ❤" Style="{StaticResource BtnSecundario}" HeightRequest="40" Clicked="OnVerFavoritosClicked" Margin="0,5,0,0" />
        </StackLayout>

        <!-- Lista de productos -->
        <RefreshView Grid.Row="2"
                     x:Name="refreshView"
                     Refreshing="OnRefreshing">
            <CollectionView x:Name="collectionViewProductos"
                            SelectionMode="Single"
                            SelectionChanged="OnProductoSelected"
                            Margin="15,10">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="{OnIdiom Phone=2, Tablet=3, Desktop=4}"
                                     VerticalItemSpacing="15"
                                     HorizontalItemSpacing="15" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Style="{StaticResource Card}" Padding="10">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Image Source="{Binding Imagen}"
                                       Aspect="AspectFill"
                                       Grid.Row="0" />
                                <Label Text="{Binding Nombre}"
                                       Grid.Row="1"
                                       Style="{StaticResource Body}"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2" />
                                <Label Text="{Binding Precio, StringFormat='${0:F2}'}"
                                       Grid.Row="2"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Exito}" />
                                <StackLayout Grid.Row="3"
                                             Orientation="Horizontal"
                                             Spacing="5">
                                    <Label Text="⭐" FontSize="14" />
                                    <Label Text="{Binding Calificacion}"
                                           Style="{StaticResource Caption}" />
                                    <Label Text="|" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding Stock, StringFormat='Stock: {0}'}"
                                           Style="{StaticResource Caption}" />
                                    <Label Text="{Binding IsFavorito, StringFormat='{0}'}"
                                           FontSize="14"
                                           IsVisible="False" />
                                </StackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <StackLayout VerticalOptions="Center" Padding="50">
                        <Label Text="📦" FontSize="64"
                               HorizontalOptions="Center" />
                        <Label Text="No se encontraron productos"
                               Style="{StaticResource H2}"
                               HorizontalOptions="Center" />
                        <Label Text="Intenta con otra búsqueda"
                               Style="{StaticResource Caption}"
                               HorizontalOptions="Center" />
                    </StackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
