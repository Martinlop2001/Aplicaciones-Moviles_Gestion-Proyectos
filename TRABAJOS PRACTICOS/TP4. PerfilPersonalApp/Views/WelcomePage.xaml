<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PerfilPersonalApp.Views.WelcomePage"
             BackgroundColor="#F0F0F0">

    <VerticalStackLayout
        Spacing="30"
        Padding="40"
        VerticalOptions="Center">

        <!-- Imagen de bienvenida -->
        <Image
            Source="dotnet_bot.png"
            HeightRequest="150"
            WidthRequest="150"
            HorizontalOptions="Center" />

        <!-- Título -->
        <Label
            Text="Bienvenido a Mi Perfil"
            FontSize="32"
            FontAttributes="Bold"
            TextColor="#2C3E50"
            HorizontalOptions="Center" />

        <!-- Subtítulo -->
        <Label
            Text="Crea y visualiza tu perfil personal"
            FontSize="16"
            TextColor="#7F8C8D"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center" />

        <!-- Botón Comenzar -->
        <Button
            Text="Comenzar"
            FontSize="18"
            BackgroundColor="#3498DB"
            TextColor="White"
            CornerRadius="25"
            HeightRequest="50"
            WidthRequest="200"
            Clicked="OnBeginClicked"
            HorizontalOptions="Center"
            Margin="0,30,0,0" />

    </VerticalStackLayout>
</ContentPage>
