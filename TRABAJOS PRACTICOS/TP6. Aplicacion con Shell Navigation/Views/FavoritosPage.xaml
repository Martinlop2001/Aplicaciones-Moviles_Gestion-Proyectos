<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BibliotecaApp.ViewModels"
             x:Class="BibliotecaApp.Views.FavoritosPage"
             Title="Favoritos">
    <ContentPage.BindingContext>
        <vm:FavoritosViewModel/>
    </ContentPage.BindingContext>
    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding Favoritos}"
                        SelectionMode="None"
                        Margin="10,0">
            <CollectionView.EmptyView>
                <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="20">
                    <Label Text="Sin favoritos aún"
                           FontSize="20"
                           TextColor="Gray"
                           HorizontalOptions="Center"/>
                    <Label Text="Agrega libros a tus favoritos desde la sección Libros"
                           FontSize="14"
                           TextColor="LightGray"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                </StackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="0,5" CornerRadius="10">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FavoritosViewModel}}, Path=IrADetalleCommand}"
                                                  CommandParameter="{Binding .}"/>
                        </Frame.GestureRecognizers>
                        <Grid ColumnSpacing="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Portada}"
                                   Aspect="AspectFill"
                                   WidthRequest="80"
                                   HeightRequest="120"/>
                            <StackLayout Grid.Column="1" Spacing="5">
                                <Label Text="{Binding Titulo}"
                                       FontSize="18"
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding Autor}"
                                       FontSize="14"
                                       TextColor="Gray"/>
                                <Label Text="{Binding Genero}"
                                       FontSize="12"
                                       TextColor="Gray"/>
                                <Label Text="{Binding Calificacion, StringFormat='{0:F1}'}"
                                       FontSize="14"
                                       FontAttributes="Bold"/>
                            </StackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
