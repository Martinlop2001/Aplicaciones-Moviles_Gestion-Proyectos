<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BibliotecaApp.ViewModels"
             x:Class="BibliotecaApp.Views.DetallePage"
             Title="Detalle">
    <ContentPage.BindingContext>
        <vm:DetalleViewModel/>
    </ContentPage.BindingContext>
    <ScrollView>
        <StackLayout Padding="20" Spacing="15">
            <Image Source="{Binding Libro.Portada}"
                   Aspect="AspectFit"
                   HeightRequest="300"/>
            <Label Text="{Binding Libro.Titulo}"
                   FontSize="28"
                   FontAttributes="Bold"/>
            <Label Text="{Binding Libro.Autor}"
                   FontSize="18"
                   TextColor="Gray"/>
            <StackLayout Orientation="Horizontal" Spacing="10">
                <Label Text="{Binding Libro.Calificacion, StringFormat='{0:F1}'}"
                       FontSize="18"
                       FontAttributes="Bold"/>
                <Label Text="|" TextColor="Gray"/>
                <Label Text="{Binding Libro.Año}"
                       FontSize="18"
                       TextColor="Gray"/>
                <Label Text="|" TextColor="Gray"/>
                <Label Text="{Binding Libro.Paginas, StringFormat='{0} páginas'}"
                       FontSize="18"
                       TextColor="Gray"/>
            </StackLayout>
            <Frame Padding="10" CornerRadius="8" BackgroundColor="LightBlue">
                <Label Text="{Binding Libro.Genero}"
                       FontSize="14"
                       FontAttributes="Bold"/>
            </Frame>
            <Label Text="Descripción"
                   FontSize="20"
                   FontAttributes="Bold"
                   Margin="0,20,0,10"/>
            <Label Text="{Binding Libro.Descripcion}"
                   FontSize="16"/>
            <Button Text=" Agregar a Favoritos"
                    Command="{Binding AlternarFavoritoCommand}"
                    BackgroundColor="Red"
                    TextColor="White"
                    Margin="0,20,0,0"/>
        </StackLayout>
    </ScrollView>
</ContentPage>
