<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BibliotecaApp.ViewModels"
             x:Class="BibliotecaApp.Views.HomePage"
             Title="Inicio">
    <ContentPage.BindingContext>
        <vm:HomeViewModel/>
    </ContentPage.BindingContext>
    <ScrollView>
        <StackLayout Padding="20" Spacing="20">
            <Label Text="Mi Biblioteca Personal"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <Frame Padding="20" CornerRadius="15" BackgroundColor="#6200EE">
                <StackLayout Spacing="10">
                    <Label Text="Resumen"
                           TextColor="White"
                           FontSize="22"
                           FontAttributes="Bold"/>
                    <Grid ColumnSpacing="15" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackLayout Grid.Column="0" HorizontalOptions="Center">
                            <Label Text="{Binding TotalLibros}"
                                   TextColor="White"
                                   FontSize="32"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"/>
                            <Label Text="Libros"
                                   TextColor="White"
                                   FontSize="14"
                                   HorizontalOptions="Center"/>
                        </StackLayout>
                        <StackLayout Grid.Column="1" HorizontalOptions="Center">
                            <Label Text="{Binding TotalFavoritos}"
                                   TextColor="White"
                                   FontSize="32"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"/>
                            <Label Text="Favoritos"
                                   TextColor="White"
                                   FontSize="14"
                                   HorizontalOptions="Center"/>
                        </StackLayout>
                        <StackLayout Grid.Column="2" HorizontalOptions="Center">
                            <Label Text="{Binding PromedioCalificacion, StringFormat='{0:F1}'}"
                                   TextColor="White"
                                   FontSize="32"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"/>
                            <Label Text="Promedio"
                                   TextColor="White"
                                   FontSize="14"
                                   HorizontalOptions="Center"/>
                        </StackLayout>
                    </Grid>
                </StackLayout>
            </Frame>

            <Label Text="Libros Recientes"
                   FontSize="22"
                   FontAttributes="Bold"/>

            <CollectionView ItemsSource="{Binding LibrosRecientes}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="15" Margin="0,5" CornerRadius="10">
                            <Grid ColumnSpacing="15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Portada}"
                                       Aspect="AspectFill"
                                       WidthRequest="80"
                                       HeightRequest="120"/>
                                <StackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                    <Label Text="{Binding Titulo}"
                                           FontSize="18"
                                           FontAttributes="Bold"/>
                                    <Label Text="{Binding Autor}"
                                           FontSize="14"
                                           TextColor="Gray"/>
                                    <Label Text="{Binding Genero}"
                                           FontSize="12"
                                           TextColor="Gray"/>
                                </StackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>
    </ScrollView>
</ContentPage>
