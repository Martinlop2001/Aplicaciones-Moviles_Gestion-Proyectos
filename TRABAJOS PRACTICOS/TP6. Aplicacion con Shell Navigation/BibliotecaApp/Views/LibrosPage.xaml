<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BibliotecaApp.ViewModels"
             x:Class="BibliotecaApp.Views.LibrosPage"
             Title="Libros">
    <ContentPage.BindingContext>
        <vm:LibrosViewModel/>
    </ContentPage.BindingContext>
    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <SearchBar Grid.Row="0"
                   Placeholder="Buscar libros..."
                   Text="{Binding TerminoBusqueda}"
                   SearchCommand="{Binding BuscarCommand}"
                   Margin="10"/>
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Libros}"
                        SelectionMode="None"
                        Margin="10,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="0,5" CornerRadius="10">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibrosViewModel}}, Path=IrADetalleCommand}"
                                                  CommandParameter="{Binding .}"/>
                        </Frame.GestureRecognizers>
                        <Grid ColumnSpacing="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Portada}"
                                   Aspect="AspectFill"
                                   WidthRequest="80"
                                   HeightRequest="120"/>
                            <StackLayout Grid.Column="1" Spacing="5">
                                <Label Text="{Binding Titulo}"
                                       FontSize="18"
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding Autor}"
                                       FontSize="14"
                                       TextColor="Gray"/>
                                <Label Text="{Binding Genero}"
                                       FontSize="12"
                                       TextColor="Gray"/>
                                <StackLayout Orientation="Horizontal" Spacing="5">
                                    <Label Text="{Binding Calificacion, StringFormat='{0:F1}'}"
                                           FontSize="14"
                                           FontAttributes="Bold"/>
                                </StackLayout>
                            </StackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
